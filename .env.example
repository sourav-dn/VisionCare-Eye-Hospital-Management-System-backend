# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
# Local (default)
MONGO_URI=mongodb://localhost:27017/eye-hospital

# Atlas (swap in your connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/eye-hospital?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ─── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Hospital Config ──────────────────────────────────────
HOSPITAL_NAME=VisionCare Eye Hospital
HOSPITAL_LOGO_URL=https://res.cloudinary.com/your_cloud_name/image/upload/v1/eye-hospital/logo.png
# ^ This will be populated automatically by the seed script after logo upload

# ─── Frontend URL (for CORS) ──────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email (Optional — future integration) ───────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@visioncare.com
